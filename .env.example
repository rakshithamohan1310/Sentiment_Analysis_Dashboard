# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reviews_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN (constructed from above in docker-compose; override here if needed)
DATABASE_URL=postgresql+asyncpg://pipeline:changeme@localhost:5432/reviews_db

# ── Security ──────────────────────────────────────────────────
# Random 32-char string used as salt for author_id hashing
AUTHOR_HASH_SALT=replace_with_a_random_32_char_string

# ── Reddit OAuth2 (https://www.reddit.com/prefs/apps) ─────────
# Create a "script" type app; fill in client_id, client_secret, user_agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ReviewPipeline/0.1 by YourUsername

# ── YouTube Data API v3 (https://console.cloud.google.com) ────
# Enable "YouTube Data API v3" and create an API key.
YOUTUBE_API_KEY=

# ── Collection settings ───────────────────────────────────────
# Maximum records to collect per source per run (can also be set per-config)
DEFAULT_MAX_RECORDS=500

# YouTube: stop collecting when remaining daily quota falls below this
YOUTUBE_QUOTA_BUFFER=500

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
