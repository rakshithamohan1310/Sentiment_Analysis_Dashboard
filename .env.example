# Copy this file to .env and fill in the blank secrets locally.
# Do not put real passwords or API keys in this example file.

# ── Database ──────────────────────────────────────────────────
# Local PostgreSQL listens on localhost:5432.
# Docker Compose uses host name "postgres" inside the compose network
# and reads POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, and POSTGRES_PORT.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=
POSTGRES_DB=reviews_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the FastAPI app and Alembic. Include the real password only in .env.
#DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name

# ── Security ──────────────────────────────────────────────────
# Generate a random 32-character string for .env. Do not reuse this placeholder.
AUTHOR_HASH_SALT=

# ── Reddit OAuth2 (https://www.reddit.com/prefs/apps) ─────────
# Script app. Read-only: client id, client secret, and user agent. No user password.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ev-review-intelligence/0.1 (local development)

# ── YouTube Data API v3 (https://console.cloud.google.com) ────
YOUTUBE_API_KEY=

# ── Collection settings ───────────────────────────────────────
DEFAULT_MAX_RECORDS=500
YOUTUBE_QUOTA_BUFFER=500

# ── Processing ────────────────────────────────────────────────
PROCESSING_BATCH_SIZE=100
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
MIN_RELEVANCE_SCORE=0.0
NEAR_DUPLICATE_THRESHOLD=0.85

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
